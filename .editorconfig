root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{json,yml,yaml}]
indent_size = 2

[source/Canopy[[]BP]/manifest.json]
indent_style = tab

[*.{md,lang}]
trim_trailing_whitespace = false

[source/Canopy[[]BP]/scripts/lib/jsep/**]
trim_trailing_whitespace = false
